---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDispatcher from "../components/hero/index.astro";
import SectionsDispatcher from "../components/sections/index.astro";
import config from "../site.config";
---
<BaseLayout description={config.description}>
  <HeroDispatcher
    title={config.name}
    subtitle={config.tagline}
    lead={config.description}
    ctaPrimary={config.pages.contatti ? { label: "Contattaci", href: "/contatti" } : undefined}
    ctaSecondary={config.pages.blog ? { label: "Leggi il blog", href: "/blog" } : undefined}
  />
  <SectionsDispatcher />
</BaseLayout>
