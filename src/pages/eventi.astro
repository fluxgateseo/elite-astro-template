---
import PageLayout from "../layouts/PageLayout.astro";
import { getEntry, render } from "astro:content";
import config from "../site.config";

// Nav adds an "Eventi" link when config.pages.eventi is true; this page must
// exist or that link 404s. Renders the eventi content page if present,
// otherwise redirects home (same pattern as chi-siamo / faq).
if (!config.pages.eventi) {
  return Astro.redirect("/");
}

const entry = await getEntry("pages", "eventi");
if (!entry) return Astro.redirect("/");

const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} description={entry.data.description}>
  <Content />
</PageLayout>
