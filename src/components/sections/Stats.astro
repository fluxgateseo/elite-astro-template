---
/**
 * Stats.astro — renders ONLY when the site config has real `stats`
 * provided by the operator. Previous versions shipped hardcoded fake
 * metrics per industry ("★ 4.7 · Recensioni clienti", "20+ Anni di
 * tradizione", "100% Materie prime selezionate", "7/7 Aperti tutta la
 * settimana") that appeared on every generated site regardless of
 * whether they were true. That is anti-slop rule #2: never invent
 * numbers.
 *
 * To render this section, add `stats: [{value, label}]` to
 * site.config.ts. Missing → the section returns null and the page
 * layout collapses around it.
 */
import config from "../../site.config";

interface StatItem { value: string; label: string }
const stats: StatItem[] = (config as { stats?: StatItem[] }).stats ?? [];
if (stats.length === 0) return null;
---

<section class="py-20" style="background:var(--color-fg);color:var(--color-bg)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-6 text-center">
      {stats.map((s) => (
        <div>
          <div
            class="font-bold mb-3"
            style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);color:var(--color-accent)"
          >
            {s.value}
          </div>
          <div class="text-xs md:text-sm uppercase tracking-widest opacity-80">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
