---
/**
 * Testimonials.astro — renders ONLY when the site config has real
 * `testimonials` provided by the operator. Previous versions shipped
 * hardcoded fake reviews per industry (Marco T., Giulia M., Luca R.
 * etc.) that appeared on every generated site regardless of whether
 * any real testimonials existed. That is anti-slop rule #1: never
 * invent testimonials.
 *
 * To render this section, add `testimonials: [{quote, author, role?}]`
 * to site.config.ts. Missing → the section returns null and the page
 * layout collapses around it.
 */
import config from "../../site.config";

interface Testimonial { quote: string; author: string; role?: string }
const testimonials: Testimonial[] = (config as { testimonials?: Testimonial[] }).testimonials ?? [];
if (testimonials.length === 0) return null;

const lang = (config.language ?? "it").toLowerCase();
const eyebrow = lang.startsWith("en") ? "What people say about us" : "Cosa dicono di noi";
const heading = lang.startsWith("en") ? "Testimonials" : "Testimonianze";
---

<section class="py-24" style="background:var(--color-bg)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--color-accent)">{eyebrow}</p>
      <h2
        class="font-bold text-3xl md:text-4xl"
        style="font-family:var(--font-display);color:var(--color-fg)"
      >
        {heading}
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
      {testimonials.map((t) => (
        <figure class="flex flex-col h-full">
          <blockquote
            class="text-lg leading-relaxed mb-6 relative pl-6"
            style="color:var(--color-fg);border-left:3px solid var(--color-accent);font-family:var(--font-display);font-style:italic"
          >
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <figcaption class="text-sm mt-auto pl-6">
            <span class="font-semibold block" style="color:var(--color-fg)">{t.author}</span>
            {t.role && <span style="color:var(--color-muted)">{t.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
