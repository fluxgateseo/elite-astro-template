---
import { getCollection } from "astro:content";
import config from "../../site.config";

let items: { title: string; href: string; description?: string; image?: string }[] = [];
try {
  const pages = await getCollection("pages");
  const candidateSlugs = ["piatti-signature","piatti-signature-firenze-rooftop-cena","menu-piatti","menu","menu-pizza-pasta"];
  const found = pages
    .filter((p) => candidateSlugs.includes(p.id.replace(/\.md$/, "")))
    .slice(0, 6)
    .map((p) => ({
      title: p.data.title || p.id.replace(/\.md$/, ""),
      href: `/${p.data.slug ?? p.id.replace(/\.md$/, "")}/`,
      description: p.data.description,
      image: (p.data as { image?: string }).image,
    }));
  items = found;
} catch {}

const heading = config.industry === "ristorazione" ? "I nostri piatti signature" : "Servizi in evidenza";
---

{items.length > 0 && (
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-12">
      <p class="text-xs font-medium uppercase tracking-widest mb-3" style="color:var(--color-accent)">In evidenza</p>
      <h2
        class="font-bold text-3xl md:text-4xl"
        style="font-family:var(--font-display);color:var(--color-fg)"
      >
        {heading}
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((it) => (
        <a
          href={it.href}
          class="group block no-underline"
          style="color:var(--color-fg)"
        >
          <div class="aspect-[4/3] overflow-hidden mb-4" style="background:var(--color-divider)">
            {it.image && (
              <img
                src={it.image}
                alt={it.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            )}
          </div>
          <h3 class="font-bold text-lg mb-2" style="font-family:var(--font-display)">{it.title}</h3>
          {it.description && (
            <p class="text-sm leading-relaxed" style="color:var(--color-muted)">
              {it.description.length > 120 ? it.description.slice(0, 117) + "…" : it.description}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
)}
